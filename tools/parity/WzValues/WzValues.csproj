<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>WzValues</AssemblyName>

    <!-- ponytail: bind to the MapleLib that docs/wz-baseline/tool already built rather than
         re-referencing the out-of-repo MapleLib.csproj. A ProjectReference would write obj/
         and bin/ under D:\games\MapleStory\Server\porting-resources, which this task may not
         touch. Override if that build output is ever cleaned:
           dotnet build -p:MapleLibBin=<dir-with-MapleLib.dll> -->
    <MapleLibBin Condition="'$(MapleLibBin)' == ''">$(MSBuildThisFileDirectory)..\..\..\docs\wz-baseline\tool\bin\Release\net10.0-windows</MapleLibBin>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MapleLib">
      <HintPath>$(MapleLibBin)\MapleLib.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- MapleLib's transitive deps: needed at runtime when an image holds a canvas or sound. -->
    <None Include="$(MapleLibBin)\MonoGame.Framework.dll;$(MapleLibBin)\NAudio*.dll;$(MapleLibBin)\Newtonsoft.Json*.dll;$(MapleLibBin)\SharpDX*.dll;$(MapleLibBin)\spine-csharp.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

</Project>
